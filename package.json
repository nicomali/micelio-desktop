{
  "name": "micelio-desktop",
  "version": "1.0.0",
  "description": "Micelio Desktop — Santander Agentic Coding Harness (Antigravity Edition)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:engine": "python -m engine.main",
    "dev:ui": "vite --port 5173",
    "dev:electron": "electron .",
    "dev": "concurrently -k \"npm:dev:engine\" \"npm:dev:ui\"",
    "build": "tsc -b && vite build",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-react": "^0.460.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
